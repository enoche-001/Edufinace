diff --git a/bank-link.js b/bank-link.js
--- a/bank-link.js	1970-01-01 01:00:00.000000000 +0100
+++ b/bank-link.js	2026-11-26 09:02:46.760025393 +0100
@@ -0,0 +1,572 @@
+/* =========================================
+   SteadyScale - Bank link (Mono Connect + free test mode)
+   - Profile > Bank accounts: link several accounts, sync each, unlink.
+   - mode 'mono': Mono Connect widget -> POST /api/mono-auth { code } -> GET /api/mono-transactions
+   - mode 'mock': fake accounts + fake transactions made on this device (no network, no limits)
+   - Both modes feed the SAME pipeline: normalize -> dedupe -> bankInbox (bank-inbox.js) -> user reviews -> ledger.
+   - Only non-secret metadata is stored: users/{uid}/linkedAccounts/{provider_accountId}.
+     No Mono secret key, no bank login, no full account number ever reaches the browser.
+   Needs: alert-parser.js, app.js (window.EduApp), sheets.js (window.EduUI), bank-inbox.js (window.EduBank)
+   ========================================= */
+(function (root) {
+    'use strict';
+
+    /* ---------- config (edit here, or set window.EDU_BANK_CONFIG before this file loads) ---------- */
+    var CONFIG = {
+        API_BASE: 'https://edufinanceapi.vercel.app',
+        MONO_PUBLIC_KEY: 'test_pk_REPLACE_ME',          // PUBLIC key only (test_pk_... for sandbox). Never put the secret key here.
+        MONO_SCRIPT: 'https://connect.withmono.com/connect.js',
+        AMOUNT_DIVISOR: 100,                            // Mono sends kobo. Use 1 if your backend already converts to naira.
+        MAX_PAGES: 6,                                   // safety cap when paging mono-transactions
+        TIMEOUT_MS: 30000,
+        MOCK_DAYS: 45                                   // how many days of fake history test accounts return
+    };
+    if (root.EDU_BANK_CONFIG) { for (var ck in root.EDU_BANK_CONFIG) { CONFIG[ck] = root.EDU_BANK_CONFIG[ck]; } }
+
+    /* =====================================================================
+       PART 1 - pure logic (no DOM, no Firebase). Unit-testable in Node.
+       ===================================================================== */
+    function pad(n) { return n < 10 ? '0' + n : '' + n; }
+    function ymd(y, m, d) { return y + '-' + pad(m) + '-' + pad(d); }
+    function today() { var n = new Date(); return ymd(n.getFullYear(), n.getMonth() + 1, n.getDate()); }
+    function sanitizeId(s) { return String(s == null ? '' : s).replace(/[^A-Za-z0-9_\-]/g, ''); }
+    function str(x) { return x && typeof x === 'object' ? String(x.name || x.title || '') : String(x == null ? '' : x); }
+    function parser() { return root.EduAlertParser || (typeof globalThis !== 'undefined' ? globalThis.EduAlertParser : null) || null; }
+
+    // 2 hashes joined: stable and short (collisions are not a practical concern at this size)
+    function hashStr(s) {
+        s = String(s); var h = 5381, g = 2166136261;
+        for (var i = 0; i < s.length; i++) {
+            var c = s.charCodeAt(i);
+            h = ((h << 5) + h + c) | 0;
+            g ^= c; g = Math.imul(g, 16777619);
+        }
+        return (h >>> 0).toString(36) + (g >>> 0).toString(36);
+    }
+
+    // The one key that makes re-syncing safe. Becomes bankInbox doc id AND the transaction's bankRef.
+    // Format: <provider>_<accountId>_<transactionId>. If that is longer than 60 chars (the inbox limit), hashes are used instead.
+    function makeRef(provider, accountId, txId) {
+        var a = sanitizeId(accountId), t = sanitizeId(txId);
+        var ref = provider + '_' + a + '_' + t;
+        if (a && t && ref.length <= 60) return ref;
+        return provider + '_' + hashStr(accountId) + '_' + hashStr(txId);
+    }
+
+    // Mono dates are ISO strings, usually midnight UTC. Midnight-UTC / date-only values use the UTC day so a
+    // transaction never slides to the day before; anything with a real time uses the user's local day.
+    function toYmd(v) {
+        if (!v) return today();
+        var s = String(v), d = new Date(s), out;
+        if (isNaN(d.getTime())) { var m = s.match(/^(\d{4})-(\d{2})-(\d{2})/); return m ? m[0] : today(); }
+        if (/^\d{4}-\d{2}-\d{2}$/.test(s) || /T00:00:00(\.0+)?(Z|\+00:00)$/.test(s)) out = ymd(d.getUTCFullYear(), d.getUTCMonth() + 1, d.getUTCDate());
+        else out = ymd(d.getFullYear(), d.getMonth() + 1, d.getDate());
+        return out > today() ? today() : out;
+    }
+
+    function tidy(raw, type) {
+        var P = parser();
+        var fallback = type === 'income' ? 'Bank credit' : 'Bank debit';
+        var out = '';
+        if (P && P.tidyDescription) out = P.tidyDescription(raw, type);
+        else out = String(raw || '').replace(/\b\d{6,}\b/g, ' ').replace(/[\/|_]+/g, ' ').replace(/\s{2,}/g, ' ').trim().slice(0, 60);
+        return out || fallback;
+    }
+
+    function bankLabel(acc) {
+        var last4 = acc.last4 ? ' ••' + acc.last4 : '';
+        return ((acc.institution || 'Bank') + last4).slice(0, 30);
+    }
+
+    // One Mono (or mock) transaction -> the shape bank-inbox.js / the ledger already use.
+    function normalizeOne(raw, account, seen) {
+        if (!raw || typeof raw !== 'object') return null;
+        var amt = Number(raw.amount);
+        if (!isFinite(amt) || amt === 0) return null;
+        var kind = String(raw.type || '').toLowerCase();
+        var type = (kind === 'credit' || kind === 'cr') ? 'income' : (kind === 'debit' || kind === 'dr') ? 'expense' : (amt < 0 ? 'expense' : null);
+        if (!type) return null;
+        var amount = Math.round(Math.abs(amt) / (CONFIG.AMOUNT_DIVISOR || 1) * 100) / 100;
+        if (!(amount > 0)) return null;
+
+        var date = toYmd(raw.date || raw.created_at || raw.createdAt);
+        var narration = String(raw.narration || raw.description || raw.reference || '');
+        var txId = raw._id || raw.id || raw.transactionId;
+        if (!txId) {   // no id from the provider: derive a stable one; identical rows in one batch get a counter
+            var key = [date, amt, kind, narration, raw.balance == null ? '' : raw.balance].join('|');
+            seen = seen || {};
+            seen[key] = (seen[key] || 0) + 1;
+            txId = 'x' + hashStr(key) + (seen[key] > 1 ? 'n' + seen[key] : '');
+        }
+        var description = tidy(narration, type);
+        var P = parser();
+        return {
+            ref: makeRef(account.provider, account.accountId, txId),
+            externalId: String(txId),
+            provider: account.provider,
+            accountId: String(account.accountId),
+            amount: amount,
+            type: type,
+            description: description,
+            category: P && P.guessCategory ? P.guessCategory(description + ' ' + narration, type) : '',
+            date: date,
+            bank: bankLabel(account)
+        };
+    }
+
+    function normalizeMany(list, account) {
+        var out = [], inBatch = {}, seen = {};
+        (Array.isArray(list) ? list : []).forEach(function (raw) {
+            var n = normalizeOne(raw, account, seen);
+            if (!n || inBatch[n.ref]) return;       // provider returned the same row twice (e.g. across pages)
+            inBatch[n.ref] = 1; out.push(n);
+        });
+        return out;
+    }
+
+    // known = { ref: 1 } built from the ledger AND every bankInbox doc (pending, imported, skipped).
+    function dedupe(items, known) {
+        var fresh = [], already = 0;
+        items.forEach(function (it) { if (known[it.ref]) already++; else fresh.push(it); });
+        return { fresh: fresh, already: already };
+    }
+
+    // Same type + amount + day as something the user added from another source (pasted alert, manual entry).
+    function markPossibleDuplicates(items, ledger) {
+        var idx = {};
+        (ledger || []).forEach(function (t) {
+            if (t.bankRef && /^(mono|mock)_/.test(t.bankRef)) return;
+            idx[t.type + '|' + Number(t.amount).toFixed(2) + '|' + t.date] = 1;
+        });
+        items.forEach(function (it) { if (idx[it.type + '|' + it.amount.toFixed(2) + '|' + it.date]) it.possibleDuplicate = true; });
+        return items;
+    }
+
+    // Accepts whatever shape /api/mono-auth returns: { id }, { data:{id} }, { account:{ _id, institution:{name}, ... } } ...
+    function pickAccount(resp, hint) {
+        var d = resp && typeof resp === 'object' ? resp : {};
+        var inner = d.data && typeof d.data === 'object' && !Array.isArray(d.data) ? d.data : d;
+        var acc = inner.account && typeof inner.account === 'object' ? inner.account : inner;
+        var id = inner.id || inner.accountId || inner._id || acc.id || acc._id || acc.accountId;
+        if (!id) return null;
+        var inst = str(acc.institution) || str(inner.institution) || str(acc.bankName) || hint || 'Bank account';
+        var num = String(acc.accountNumber || acc.account_number || inner.accountNumber || '').replace(/\D/g, '');
+        return {
+            provider: 'mono', accountId: String(id), institution: inst.slice(0, 40),
+            accountName: str(acc.name) || str(acc.accountName) || '', last4: num.slice(-4),
+            currency: str(acc.currency) || 'NGN'
+        };
+    }
+
+    /* ----- mock provider: deterministic fake data in Mono's own response shape (kobo, debit/credit, ISO date) ----- */
+    var MOCK_BANKS = ['GTBank', 'Kuda', 'Opay', 'Access Bank', 'Zenith Bank', 'Moniepoint'];
+    var MOCK_DEBITS = [
+        ['POS/SHOPRITE IKEJA', 3500, 18000], ['UBER TRIP LAGOS', 1200, 6500], ['BOLT RIDE', 900, 4500],
+        ['NIP/TRF TO ADAEZE OKORO/LUNCH', 1500, 7000], ['MTN AIRTIME VTU', 500, 3000], ['CHOWDECK ORDER', 2500, 9000],
+        ['PHCN PREPAID TOKEN', 5000, 15000], ['PHARMACY MEDPLUS', 1800, 9000], ['KFC SURULERE', 3200, 8200],
+        ['USSD/TRF TO CHIDI OKAFOR', 2000, 15000]
+    ];
+    var MOCK_CREDITS = [['NIP/TRF FROM MUM', 10000, 50000], ['TRF FROM CLIENT/INVOICE 112', 25000, 120000]];
+
+    function rng(seed) {
+        var a = parseInt(hashStr(seed).slice(0, 6), 36) | 0;
+        return function () {
+            a = (a + 0x6D2B79F5) | 0;
+            var t = Math.imul(a ^ (a >>> 15), 1 | a);
+            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+        };
+    }
+    function between(r, lo, hi) { return Math.round((lo + r() * (hi - lo)) / 50) * 50; }
+
+    // Same account + same day always gives the same ids, so re-syncing returns the same rows
+    // (and a later sync adds only the days that have passed since).
+    function mockTransactions(account, now) {
+        now = now || new Date();
+        var out = [];
+        for (var back = CONFIG.MOCK_DAYS - 1; back >= 0; back--) {
+            var day = new Date(now.getFullYear(), now.getMonth(), now.getDate() - back);
+            var key = ymd(day.getFullYear(), day.getMonth() + 1, day.getDate());
+            var iso = new Date(Date.UTC(day.getFullYear(), day.getMonth(), day.getDate())).toISOString();
+            var r = rng(account.accountId + key), n = 0;
+            function push(narr, naira, type) {
+                out.push({ _id: 'd' + key.replace(/-/g, '') + 'n' + (n++), narration: narr, amount: Math.round(naira * 100), type: type, balance: null, date: iso });
+            }
+            if (r() < 0.6) { var a = MOCK_DEBITS[Math.floor(r() * MOCK_DEBITS.length)]; push(a[0], between(r, a[1], a[2]), 'debit'); }
+            if (r() < 0.25) { var b = MOCK_DEBITS[Math.floor(r() * MOCK_DEBITS.length)]; push(b[0], between(r, b[1], b[2]), 'debit'); }
+            if (r() < 0.06) { var c = MOCK_CREDITS[Math.floor(r() * MOCK_CREDITS.length)]; push(c[0], between(r, c[1], c[2]), 'credit'); }
+            if (day.getDate() === 25) push('SALARY ACME LTD', 250000, 'credit');
+            if (day.getDate() === 5) push('NETFLIX.COM', 4400, 'debit');
+        }
+        return out;
+    }
+
+    var api = {
+        CONFIG: CONFIG, makeRef: makeRef, toYmd: toYmd, normalizeOne: normalizeOne, normalizeMany: normalizeMany,
+        dedupe: dedupe, markPossibleDuplicates: markPossibleDuplicates, pickAccount: pickAccount, mockTransactions: mockTransactions
+    };
+    if (typeof module !== 'undefined' && module.exports) module.exports = api;
+    root.EduBankLink = api;
+
+    if (typeof document === 'undefined') return;
+
+    /* =====================================================================
+       PART 2 - browser: Linked Accounts UI, Mono widget, sync
+       ===================================================================== */
+    var $ = function (id) { return document.getElementById(id); };
+    var db, auth, uid = null, accounts = [], unsub = null;
+    var mode = 'mono', busy = {}, linking = false;
+
+    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c]; }); }
+    function toast(m, t) { if (root.EduApp) root.EduApp.toast(m, t || 'info'); }
+    function userCol(name) { return db.collection('users').doc(uid).collection(name); }
+    function docId(a) { return a.provider + '_' + sanitizeId(a.accountId); }
+    function ledger() { return (root.EduApp && root.EduApp.transactions()) || []; }
+    function plural(n, w) { return n + ' ' + w + (n === 1 ? '' : 's'); }
+
+    function ago(iso) {
+        if (!iso) return 'Not synced yet';
+        var m = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
+        if (m < 1) return 'Synced just now';
+        if (m < 60) return 'Synced ' + m + ' min ago';
+        if (m < 1440) return 'Synced ' + Math.round(m / 60) + ' h ago';
+        return 'Synced ' + Math.round(m / 1440) + ' d ago';
+    }
+
+    /* ----- mode (per user, per device) ----- */
+    function modeKey() { return 'edu_bank_mode_v1_' + (uid || 'guest'); }
+    function loadMode() { try { var m = localStorage.getItem(modeKey()); mode = m === 'mock' ? 'mock' : 'mono'; } catch (e) { mode = 'mono'; } }
+    function setMode(m) {
+        mode = m === 'mock' ? 'mock' : 'mono';
+        try { localStorage.setItem(modeKey(), mode); } catch (e) {}
+        render();
+    }
+
+    /* ----- backend calls ----- */
+    function getToken() {
+        var u = auth && auth.currentUser;
+        return u ? u.getIdToken() : Promise.reject({ code: 'auth' });
+    }
+    function apiFetch(path, opts) {
+        return getToken().then(function (token) {
+            var ctrl = new AbortController(), timer = setTimeout(function () { ctrl.abort(); }, CONFIG.TIMEOUT_MS);
+            opts = opts || {};
+            opts.headers = Object.assign({ 'Authorization': 'Bearer ' + token }, opts.headers || {});
+            opts.signal = ctrl.signal;
+            return fetch(CONFIG.API_BASE + path, opts).then(function (res) {
+                return res.text().then(function (txt) {
+                    var body = null; try { body = txt ? JSON.parse(txt) : null; } catch (e) {}
+                    if (!res.ok) throw { code: 'http', status: res.status, body: body };
+                    return body;
+                });
+            }).catch(function (e) {
+                if (e && e.code) throw e;
+                throw { code: e && e.name === 'AbortError' ? 'timeout' : 'network' };
+            }).then(function (v) { clearTimeout(timer); return v; }, function (e) { clearTimeout(timer); throw e; });
+        });
+    }
+    function friendly(e) {
+        if (!e) return 'Something went wrong. Please try again.';
+        if (e.code === 'auth') return 'Please sign in again.';
+        if (e.code === 'timeout') return 'The bank took too long to answer. Try again.';
+        if (e.code === 'network') return 'No connection. Check your internet and try again.';
+        if (e.code === 'inbox') return 'The bank inbox is not ready yet. Refresh the page and try again.';
+        if (e.code === 'unexpected') return 'The server reply was not what the app expected.';
+        if (e.code === 'http') {
+            if (e.status === 401) return 'Your session expired. Sign in again.';
+            if (e.status === 429) return 'Too many requests. Wait a minute and try again.';
+            if (e.status === 404) return 'That bank account was not found.';
+            if (e.status === 403) return 'The bank needs you to reconnect this account.';
+            return 'The bank service is unavailable (' + e.status + '). Try again later.';
+        }
+        if (e.permission) return 'Could not save. Check the Firestore rules for linkedAccounts.';
+        return 'Something went wrong. Please try again.';
+    }
+
+    function extractList(r) {
+        if (Array.isArray(r)) return r;
+        if (!r) return [];
+        if (Array.isArray(r.data)) return r.data;
+        if (r.data && Array.isArray(r.data.data)) return r.data.data;
+        if (Array.isArray(r.transactions)) return r.transactions;
+        return [];
+    }
+    function paging(r) { return (r && (r.paging || r.meta || (r.data && (r.data.paging || r.data.meta)))) || {}; }
+
+    function fetchMono(accountId) {
+        var all = [], seen = {};
+        function page(n) {
+            var q = '/api/mono-transactions?accountId=' + encodeURIComponent(accountId) + (n > 1 ? '&page=' + n : '');
+            return apiFetch(q, { method: 'GET' }).then(function (res) {
+                var list = extractList(res), fresh = 0;
+                list.forEach(function (t) {
+                    var id = t && (t._id || t.id);
+                    if (id) { if (seen[id]) return; seen[id] = 1; }
+                    all.push(t); fresh++;
+                });
+                var p = paging(res);
+                var more = !!p.next || (p.total && all.length < p.total);
+                if (more && fresh > 0 && n < CONFIG.MAX_PAGES) return page(n + 1);   // stops if the server ignores ?page
+                return all;
+            });
+        }
+        return page(1);
+    }
+
+    function fetchRaw(acc) {
+        if (acc.provider === 'mock') return Promise.resolve(mockTransactions(acc));
+        return fetchMono(acc.accountId);
+    }
+
+    /* ----- inbox plumbing ----- */
+    function knownRefs() {
+        var set = {};
+        ledger().forEach(function (t) { if (t.bankRef) set[t.bankRef] = 1; });
+        return userCol('bankInbox').get().then(function (snap) {   // pending + imported + skipped: nothing is ever re-queued
+            snap.forEach(function (d) { set[d.id] = 1; });
+            return set;
+        });
+    }
+    function addChunks(items, source) {
+        if (!items.length) return Promise.resolve();
+        if (!root.EduBank) return Promise.reject({ code: 'inbox' });
+        var p = Promise.resolve();
+        for (var i = 0; i < items.length; i += 400) {
+            (function (part) { p = p.then(function () { return root.EduBank.addToInbox(part, source); }); })(items.slice(i, i + 400));
+        }
+        return p;
+    }
+    function chunkDelete(refs) {
+        var p = Promise.resolve();
+        for (var i = 0; i < refs.length; i += 400) {
+            (function (part) { p = p.then(function () { var b = db.batch(); part.forEach(function (r) { b.delete(r); }); return b.commit(); }); })(refs.slice(i, i + 400));
+        }
+        return p;
+    }
+    function refsWhere(col, field, val) {
+        return userCol(col).where(field, '==', val).get().then(function (s) { var r = []; s.forEach(function (d) { r.push(d.ref); }); return r; });
+    }
+
+    /* ----- sync one account ----- */
+    function syncAccount(acc) {
