+    }
+
+    function syncAll() {
+        if (EduGate('Sign up to link your bank.')) return;
+        var list = accounts.filter(function (a) { return a.provider === mode && a.status !== 'reauth'; });
+        var added = 0, p = Promise.resolve();
+        list.forEach(function (a) { p = p.then(function () { return syncAccount(a).then(function (r) { if (r) added += r.added; }); }); });
+        p.then(function () { toast(added ? plural(added, 'new transaction') + ' from ' + plural(list.length, 'account') : 'Everything is up to date.', added ? 'success' : 'info'); });
+    }
+
+    /* ----- link ----- */
+    function saveAccount(meta) {
+        var id = docId(meta), exists = accounts.some(function (a) { return a.id === id; });
+        var data = {
+            provider: meta.provider, accountId: meta.accountId, institution: meta.institution, accountName: meta.accountName || '',
+            last4: meta.last4 || '', currency: meta.currency || 'NGN', status: 'active'
+        };
+        if (!exists) { data.linkedAt = new Date().toISOString(); data.lastSyncAt = null; data.lastSyncCount = 0; }
+        return userCol('linkedAccounts').doc(id).set(data, { merge: true }).then(function () {
+            return Object.assign({ id: id }, data);
+        }, function (e) { e.permission = true; throw e; });
+    }
+
+    function afterLink(acc, existed) {
+        return syncAccount(acc).then(function (res) {
+            if (existed) { toast('That account was already linked. Synced it again.', 'info'); return; }
+            syncReport(acc, res);
+            if (res && res.added && root.EduBank) root.EduBank.openInbox();
+        });
+    }
+
+    function linkMock() {
+        var used = accounts.filter(function (a) { return a.provider === 'mock'; }).map(function (a) { return a.institution; });
+        var bank = MOCK_BANKS.filter(function (b) { return used.indexOf(b) === -1; })[0] || MOCK_BANKS[used.length % MOCK_BANKS.length];
+        var rand = Math.random().toString(36).slice(2, 7);
+        var meta = {
+            provider: 'mock', accountId: 'tst' + Date.now().toString(36).slice(-4) + rand, institution: bank,
+            accountName: 'Test account', last4: String(1000 + Math.floor(Math.random() * 9000)), currency: 'NGN'
+        };
+        linking = true; render();
+        saveAccount(meta).then(function (acc) { return afterLink(acc, false); })
+            .catch(function (e) { toast(friendly(e), 'error'); })
+            .then(function () { linking = false; render(); });
+    }
+
+    function monoCtor() { var C = root.Connect || root.MonoConnect; return C && (C.default || C); }
+    function loadMono() {
+        return new Promise(function (resolve, reject) {
+            if (monoCtor()) return resolve(monoCtor());
+            var s = document.createElement('script');
+            s.src = CONFIG.MONO_SCRIPT; s.async = true;
+            s.onload = function () { monoCtor() ? resolve(monoCtor()) : reject({ code: 'widget' }); };
+            s.onerror = function () { reject({ code: 'widget' }); };
+            document.head.appendChild(s);
+        });
+    }
+
+    function linkMono() {
+        if (!CONFIG.MONO_PUBLIC_KEY || /REPLACE_ME/.test(CONFIG.MONO_PUBLIC_KEY)) {
+            toast('Add your Mono public key in bank-link.js, or switch to Test data.', 'error'); return;
+        }
+        linking = true; render();
+        var hint = '', handled = false;
+        function done() { linking = false; render(); }
+        loadMono().then(function (Connect) {
+            var widget = new Connect({
+                key: CONFIG.MONO_PUBLIC_KEY, scope: 'auth',
+                onSuccess: function (r) {
+                    handled = true;
+                    var code = r && r.code;
+                    if (!code) { toast('The bank did not return a link code. Try again.', 'error'); return done(); }
+                    apiFetch('/api/mono-auth', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code: code }) })
+                        .then(function (resp) {
+                            var meta = pickAccount(resp, hint);
+                            if (!meta) { if (root.console) console.warn('mono-auth: no account id in reply, keys =', resp && Object.keys(resp)); throw { code: 'unexpected' }; }
+                            var existed = accounts.some(function (a) { return a.id === docId(meta); });
+                            return saveAccount(meta).then(function (acc) { return afterLink(acc, existed); });
+                        })
+                        .catch(function (e) { toast(friendly(e), 'error'); })
+                        .then(done);
+                },
+                onClose: function () { if (!handled) done(); },
+                onEvent: function (name, data) {
+                    try { var n = data && (str(data.institution) || data.institutionName || data.bankName); if (n) hint = String(n); } catch (e) {}
+                }
+            });
+            widget.setup(); widget.open();
+        }).catch(function () { toast('Could not load the Mono window. Check your connection, or use Test data.', 'error'); done(); });
+    }
+
+    function onLink() {
+        if (EduGate('Sign up to link your bank.')) return;
+        if (linking) return;
+        if (mode === 'mock') linkMock(); else linkMono();
+    }
+    function EduGate(msg) { return root.EduUI ? root.EduUI.gate(msg) : false; }
+
+    function unlink(acc) {
+        var tail = acc.provider === 'mock' ? '' : ' Transactions you already added stay in your list.';
+        if (!window.confirm('Unlink ' + acc.institution + '?' + tail)) return;
+        userCol('linkedAccounts').doc(acc.id).delete()
+            .then(function () { toast('Account unlinked', 'info'); })
+            .catch(function () { toast('Could not unlink. Try again.', 'error'); });
+    }
+
+    // Removes every test account, test inbox item and test transaction. Real data is untouched.
+    function clearTest() {
+        if (!window.confirm('Remove all test accounts and the test transactions made from them (including ones you already added)?')) return;
+        var mine = accounts.filter(function (a) { return a.provider === 'mock'; }).map(function (a) { return userCol('linkedAccounts').doc(a.id); });
+        Promise.all([refsWhere('bankInbox', 'provider', 'mock'), refsWhere('transactions', 'provider', 'mock')])
+            .then(function (r) { return chunkDelete(mine.concat(r[0], r[1])); })
+            .then(function () { toast('Test data removed', 'success'); })
+            .catch(function () { toast('Could not remove test data. Try again.', 'error'); });
+    }
+
+    // Called by app.js when the user resets all data, so a later sync can bring history back in.
+    function resetAll() {
+        if (!uid) return Promise.resolve();
+        return userCol('bankInbox').get().then(function (s) { var r = []; s.forEach(function (d) { r.push(d.ref); }); return chunkDelete(r); });
+    }
+
+    /* ----- UI ----- */
+    function render() {
+        var box = $('blList'); if (!box) return;
+        var segs = document.querySelectorAll('#blMode .seg-btn');
+        Array.prototype.forEach.call(segs, function (b) { var on = b.dataset.mode === mode; b.classList.toggle('active', on); b.setAttribute('aria-pressed', on); });
+        var note = $('blModeNote');
+        if (note) note.textContent = mode === 'mock'
+            ? 'Test mode: fake accounts and transactions made on this device. Nothing touches a real bank. They show in your bank inbox marked Test.'
+            : 'Link an account with Mono. We keep only the bank name and a reference ID, never your bank login. New transactions land in your bank inbox for you to review.';
+
+        var list = accounts.filter(function (a) { return a.provider === mode; })
+            .sort(function (a, b) { return String(a.linkedAt || '').localeCompare(String(b.linkedAt || '')); });
+        if (!list.length) {
+            box.innerHTML = '<p class="empty">' + (mode === 'mock' ? 'No test accounts yet. Tap the button to add one.' : 'No bank linked yet.') + '</p>';
+        } else {
+            box.innerHTML = list.map(function (a) {
+                var meta = [a.last4 ? '••' + a.last4 : '', a.status === 'reauth' ? 'Reconnect needed' : ago(a.lastSyncAt),
+                    a.lastSyncAt && a.lastSyncCount ? a.lastSyncCount + ' new' : ''].filter(Boolean).join(' · ');
+                return '<div class="bl-item" data-id="' + esc(a.id) + '">' +
+                    '<span class="bl-ico"><i class="fa-solid fa-building-columns"></i></span>' +
+                    '<div class="bl-main"><b>' + esc(a.institution) + (a.provider === 'mock' ? ' <span class="chip bl-chip">Test</span>' : '') + '</b>' +
